{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "worktree": {
    "sparsePaths": [".claude", "src", "src/assets", "src/components", "src/hooks", "src/utils"],
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/../../.claude/hooks/filter-test-output.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/**/dist/**)",
      "Read(./**/**/build/**)",
      "Read(./**/**/node_modules/**)",
      "Read(./packages/app/modifierEffects.json)"
    ]
  }
}
